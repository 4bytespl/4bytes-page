---
import Font from "astro/components/Font.astro";
import "../styles/global.css";
---

<html lang="pl">
	<head>
		<meta charset="utf-8" />
		<link
			rel="icon"
			type="image/svg+xml"
			href={`${import.meta.env.BASE_URL}logo.svg`}
		/>
		<meta name="viewport" content="width=device-width" />
		<meta
			name="description"
			content="4Bytes — studencki klub blockchain"
		/>
		<meta property="og:title" content="4Bytes" />
		<meta
			property="og:description"
			content="4Bytes — studencki klub blockchain"
		/>
		<meta property="og:type" content="website" />
		<meta
			property="og:image"
			content={`${import.meta.env.BASE_URL}logo.svg`}
		/>
		<title>4Bytes — studencki klub blockchain</title>
		<Font cssVariable="--font-sans" />
		<Font cssVariable="--font-mono" preload />
	</head>
	<body class="px-6 md:px-16 mx-auto py-12 overflow-x-hidden w-full">
		<slot ? />
	</body>
</html>
