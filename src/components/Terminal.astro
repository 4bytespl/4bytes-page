---
interface Props {
	title?: string;
}

const { title = "terminal" } = Astro.props;
---

<div class="w-full rounded-xl border border-background/20 bg-box overflow-hidden shadow-2xl">
	<div class="flex items-center justify-between px-4 py-3 bg-background/40 border-b border-background/20">
		<div class="flex items-center space-x-2">
			<div class="w-3 h-3 rounded-full bg-[#FF5F56]/80"></div>
			<div class="w-3 h-3 rounded-full bg-[#FFBD2E]/80"></div>
			<div class="w-3 h-3 rounded-full bg-[#27C93F]/80"></div>
		</div>

		<div class="text-xs text-muted font-mono select-none">
			{title}
		</div>

		<div class="w-10"></div>
	</div>

	<div class="p-4 max-h-148 overflow-auto text-sm leading-relaxed bg-[#1e1e1e] text-left">
		<slot />
	</div>
</div>
