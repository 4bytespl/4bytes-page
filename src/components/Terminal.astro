---
interface Props {
  title?: string;
}

const { title = "terminal" } = Astro.props;
---

<div class="w-full max-w-2xl rounded-xl border bg-box overflow-hidden">
  <div class="flex items-center justify-between px-4 py-3 border-b border-background">
    <div class="flex items-center space-x-2">
      <div class="w-3 h-3 rounded-full"></div>
      <div class="w-3 h-3 rounded-full"></div>
      <div class="w-3 h-3 rounded-full"></div>
    </div>

    <div class="text-xs text-muted select-none">{title}</div>

    <div class="p-5 overflow-x-auto text-sm leading-relaxed text-muted">
      <slot />
    </div>
  </div>
</div>
