---
import BaseLayout from "../layouts/BaseLayout.astro";
import Terminal from "../components/Terminal.astro";
---

<BaseLayout>
  <main class="min-h-[85vh] flex flex-col items-center justify-center px-6">
    <div class="w-full max-w-2xl">
      <Terminal title="sys/error.log">
        <div class="space-y-4 font-mono text-xs sm:text-sm leading-relaxed">
          <div class="text-red-500 font-bold">
            [404] route not found in index table
          </div>

          <div class="text-muted/70 space-y-1 text-xs border-l border-white/10 pl-3">
            <p>$ curl -I https://4bytes.pl$REQUEST_URI</p>
            <p>HTTP/2 404 Not Found</p>
            <p>content-type: text/plain</p>
          </div>

          <div class="pt-3 flex items-center justify-between border-t border-white/5">
            <div class="flex items-center gap-2 text-primary">
              <span class="text-muted/60">root@4bytes:~#</span>
              <span class="text-foreground">cd /home</span>
              <span class="inline-block w-2 h-4 bg-primary animate-pulse"></span>
            </div>

            <a
              href="/"
              class="bg-primary px-4 py-1.5 rounded-lg text-background font-mono font-bold text-xs uppercase tracking-wider transition hover:bg-primary-muted hover:-translate-y-0.5 cursor-pointer"
            >
              wykonaj
            </a>
          </div>
        </div>
      </Terminal>
    </div>
  </main>
</BaseLayout>
