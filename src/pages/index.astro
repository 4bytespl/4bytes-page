---
import { Code } from "astro:components";
import Terminal from "../components/Terminal.astro";
import ProjectElem from "../components/ProjectElem.astro";
import AboutUsBlock from "../components/AboutUsBlock.astro";
import BaseLayout from "../layouts/BaseLayout.astro";

const code = `import hre from "hardhat";
  
async function main() {
  const Factory = await hre.ethers.getContractFactory("Factory");
  const factory = await Factory.deploy();
  console.log("factory deployed at address: ", await factory.getAddress());
  const artifact = await hre.artifacts.readArtifact("Factory");
  console.log("Factory ABI:", JSON.stringify(artifact.abi, null, 2));
}

async function getCampaignAbi() {
  const artifact = await hre.artifacts.readArtifact("Campaign");
  console.log("Campaign ABI:", JSON.stringify(artifact.abi, null, 2));
}
`;
---

<BaseLayout>
	<header class="flex items-center justify-between mb-16 md:mb-32">
		<a href={`${import.meta.env.BASE_URL}/`}>			
			<img
				src={`${import.meta.env.BASE_URL}/logo.svg`}
				class="h-12"
			/>
		</a>

		<label for="menu" class="md:hidden" id="burger">
			<span class="block w-6 h-0.5 bg-foreground mb-1.5"></span>
			<span class="block w-6 h-0.5 bg-foreground mb-1.5"></span>
			<span class="block w-6 h-0.5 bg-foreground"></span>
		</label>

		<nav
			id="menu"
			class="hidden md:flex flex-col md:flex-row
              absolute md:static top-24 left-0 w-full md:w-auto
              bg-background md:bg-transparent p-6 md:p-0 gap-6 md:gap-12"
		>
			<a
				class="transition hover:opacity-85 hover:-translate-y-0.5"
				href="#projects"
			>
				Projekty
			</a>
			<a
				class="transition hover:opacity-85 hover:-translate-y-0.5"
				href="#features"
			>
				Cechy
			</a>
			<a
				class="transition hover:opacity-85 hover:-translate-y-0.5"
				href="#about-us"
			>
				O nas
			</a>
			<a
				class="transition hover:opacity-85 hover:-translate-y-0.5"
				href="#contacts"
			>
				Kontakty
			</a>
		</nav>
		<script>
			document.getElementById("burger")?.addEventListener(
				"click",
				() => {
					document.getElementById(
						"menu",
					)?.classList.toggle("hidden");
					document.getElementById(
						"menu",
					)?.classList.toggle("flex");
				},
			);
		</script>
	</header>

	<main class="grid gap-16 md:gap-32">
		<section class="justify-between min-w-0 gap-4 flex flex-col lg:flex-row sm:pt-24 sm:pb-24">
			<div class="flex flex-col gap-6 col-span-6 flex-1">
				<h1 class="text-4xl md:text-5xl tracking-1 font-extrabold">
					Przygotuj z nami{" "}
					<span class="text-primary landing-highlight">
						pyszny
					</span>{" "}
					system kopania
				</h1>
				<p class="text-muted max-w-xl">
					W 4Bytes poznasz technologię blockchain
					od podstaw, zrozumiesz zasady
					decentralizacji i nauczysz się tworzyć
					smart kontrakty w języku Solidity.
					Zdobędziesz praktyczne umiejętności w
					zakresie zdalnego zarządzania serwerami
					oraz konfiguracji środowisk do kopania
					kryptowalut
				</p>
				<a
					class="px-6 py-4 bg-primary w-fit text-background rounded-4xl transition hover:-translate-y-0.5 hover:bg-primary-muted"
					target="_blank"
					href="https://docs.google.com/forms/d/e/1FAIpQLSeClQfQMHbxdpMsLGeGBLWjHF0dEloLLc8yNDi3gaPqFXah5g/viewform?usp=publish-editor"
					rel="noopener noreferrer"
				>
					Rozpocznij naukę
				</a>
			</div>

			<div class="col-span-6 w-full flex-1">
				<Terminal title="deploy.ts">
					<Code
						code={code}
						lang="ts"
						theme="min-dark"
						wrap
					/>
				</Terminal>
			</div>
		</section>
		<div class="underline" />
		<section
			id="projects"
			class="grid text-center gap-16 max-w-4xl m-auto"
		>
			<div class="max-w-xl grid gap-3 m-auto">
				<h2 class="py-2 px-4 bg-background-muted text-center w-min whitespace-nowrap rounded-xl text-lg sm:text-xl mx-auto">
					Projekty
				</h2>
				<span class="opacity-80 text-sm">
					O naszych projektach
				</span>
				<h3>
					Jakie projekty zrealizujemy podczas
					naszego kursu i czego się nauczymy
				</h3>
			</div>
			<div class="overflow-auto p-3 sm:p-6 border-2 border-background-muted rounded-xl text-left">
				<div class="grid gap-4 mb-4">
					<h3 class="text-xl">
						4bytes /{" "}
						<span class="text-primary">
							projekty
						</span>
					</h3>
					<p class="text-sm opacity-80">
						// 4 repozytoria · zapisy
						otwarte
					</p>
				</div>
				<div class="underline" />
				<ul class="flex flex-col gap-6">
					<ProjectElem
						svg={`${import.meta.env.BASE_URL}/book.png`}
						name="DAO-dapp"
						badge="planowany"
						text="Forum, w którym każdy wątek jest propozycją — dyskusja, poprawki, a na końcu głosowanie tokenami"
						topics={[
							"solidity",
							"hardhat",
							"ethers.js",
						]}
						language="Solidity"
					/>
					<ProjectElem
						svg={`${import.meta.env.BASE_URL}/book.png`}
						name="amm-lab"
						badge="planowany"
						text="Własny DEX od zera — pule płynności, swapy i pożyczki. Przechodzimy Uniswapa v1 → v4, żeby zobaczyć, co każda wersja naprawdę zmieniła"
						topics={[
							"solidity",
							"foundry",
							"ethers.js",
						]}
						language="Solidity"
					/>
					<ProjectElem
						svg={`${import.meta.env.BASE_URL}/book.png`}
						name="rig-tuning"
						badge="planowany"
						text="Składamy koparkę na CPU i GPU, a potem stroimy ją pod cenę prądu — tak, żeby każdy wat dawał maksimum hashy dla wybranej monety"
						topics={["cuda", "bash"]}
						language="Python"
					/>
					<ProjectElem
						svg={`${import.meta.env.BASE_URL}/lock.png`}
						name="??? - nazwa wkrótce"
						badge="pomysł"
						text="Masz pomysł na projekt? Otwórz issue - to miejsce czeka na Twój pomysł"
						gray={true}
					/>
				</ul>
			</div>
		</section>
		<div class="underline" />
		<section
			id="features"
			class="grid text-center gap-16 max-w-4xl m-auto"
		>
			<div class="max-w-xl grid gap-3 m-auto">
				<h2 class="py-2 px-4 bg-background-muted text-center w-min whitespace-nowrap rounded-xl text-xl mx-auto">
					Cechy
				</h2>
				<span class="opacity-80 text-sm">
					Dlaczego warto do nas dołączyć
				</span>
				<h3 class="">
					Ekran pomocy — krótko o tym, co
					oferujemy
				</h3>
			</div>
			<Terminal>
				<p class="text-accent">$ 4bytes --help</p>
				<br />
				<p class="opacity-60">USAGE</p>
				<p>4bytes [OPTIONS]</p>
				<br />
				<p class="opacity-60">DESCRIPTION</p>
				<p>
					Studenckie koło naukowe — blockchain,
					Solidity, kryptowaluty.
				</p>
				<br />
				<p class="opacity-60">OPTIONS</p>
				<p>
					<span class="text-primary">
						--od-zera
					</span>{" "}
					Nie zakładamy żadnej wiedzy o
					blockchainie.
				</p>
				<p class="opacity-60">
					Zaczynamy od tego, czym jest sieć bez
					właściciela
				</p>
				<br />
				<p>
					<span class="text-primary">
						--w-zespole
					</span>{" "}
					Nad każdym projektem pracuje kilka osób.
				</p>
				<p class="opacity-60">
					Nikt nie utknie sam z błędem na trzy
					tygodnie
				</p>
				<br />
				<p>
					<span class="text-primary">
						--mentoring
					</span>{" "}
					Code review na każdym PR
				</p>
				<p class="opacity-60">
					Wykładowca-opiekun i starsi studenci
					czuwają nad kierunkiem, w którym idzie
					projekt.
				</p>
				<br />
				<p>
					<span class="text-primary">
						--portfolio
					</span>{" "}
					Wychodzisz z działającym kodem,
				</p>
				<p class="opacity-60">
					Który możesz pokazać na rozmowie o
					pracę.
				</p>
				<br />
				<p>
					<span class="text-primary">
						--open-source
					</span>{" "}
					Wszystko co budujemy jest publiczne na
					GitHubie
				</p>
				<br />
			</Terminal>
		</section>
		<div class="underline" />
		<section
			id="about-us"
			class="grid text-center gap-16 max-w-4xl m-auto"
		>
			<div class="max-w-xl grid gap-3 m-auto">
				<h2 class="py-2 px-4 bg-background-muted text-center w-min whitespace-nowrap rounded-xl text-xl mx-auto">
					O nas
				</h2>
				<span class="opacity-80 text-sm">
					Koło naukowe z blockchain
				</span>
				<h3 class="">
					Zacznij uczyć się podstaw technologii
					blockchain razem z nami w przyjaznym
					zespole
				</h3>
			</div>
			<div class="sm:w-md m-auto">
				<Terminal>
					<p class="text-accent">$ whoami</p>
					<p>Kolo_naukowe_4bytes</p>
					<p class="text-accent">$ status</p>
					<p class="text-[#FFBD2E]">
						active - przyjmujemy nowych
						czlonkow
					</p>
				</Terminal>
			</div>
			<div class="grid gap-3 text-left">
				<h3 class="opacity-80 text-xl">
					// JAK DZIALAMY
				</h3>
				<div class="grid md:grid-cols-3 gap-6 md:gap-12">
					<AboutUsBlock
						title="Cotygodniowe spotkania"
						text="Live coding i omawianie tematów"
					/>
					<AboutUsBlock
						title="Praktyczne projekty"
						text="DEX, DAO i inne budowane razem"
					/>
					<AboutUsBlock
						title="Mentoring"
						text="Starsi czlonkowie pomagaja nowym"
					/>
				</div>
			</div>
			<div>
				<div class="mb-12">
					<h2 class="text-4xl md:text-5xl mb-4 font-[800] tracking-1 text-left">
						Łączy nas{" "}
						<span class="text-primary">
							blockchain
						</span>
						. Rozwijamy się przez praktykę.
					</h2>
					<p class="opacity-80 text-left">
						4bytes to studenckie koło
						naukowe skupione wokół
						technologii blockchain, Solidity
						i kryptowalut.
					</p>
				</div>
				<div class="grid gap-6">
					<div class="bg-background-muted p-6 rounded-xl text-left grid gap-4 transition duration-200 ease-in hover:bg-background-primary">
						<h3>
							<span class="w-3 h-3 rounded-full bg-primary inline-block"></span>{" "}
							# Kim jesteśmy
						</h3>
						<p class="opacity-80 text-sm">
							Jesteśmy grupą
							studentów, których
							połączyło jedno pytanie:
							jak sieć bez właściciela
							potrafi pilnować cudzych
							pieniędzy. Przyszliśmy z
							różnych lat i kierunków
							— jednych wciągnęła
							kryptografia, innych
							rynek, resztę czysty
							kod. Nie jesteśmy firmą
							ani startupem: jesteśmy
							kołem, w którym nikt nie
							musi udawać, że wie
							wszystko
						</p>
					</div>
					<div class="bg-background-muted p-6 rounded-xl text-left grid gap-4 transition duration-200 ease-in hover:bg-background-primary">
						<h3>
							<span class="w-3 h-3 rounded-full bg-primary inline-block"></span>{" "}
							# Co robimy
						</h3>
						<p class="opacity-80 text-sm">
							Na cotygodniowych
							spotkaniach przechodzimy
							przez kolejne warstwy
							technologii blockchain —
							od podstaw działania
							sieci i kryptografii,
							przez pisanie smart
							kontraktów w Solidity,
							aż po budowę pełnych
							aplikacji:
							zdecentralizowanych
							giełd (DEX), systemów
							pożyczkowych i
							organizacji DAO.{" "}
							<span class="text-primary">
								Każdy temat
								kończymy
								projektem
							</span>
							, który trafia do
							naszego portfolio — to
							nie jest nauka “do
							szuflady”.
						</p>
					</div>
					<div class="bg-background-muted p-6 rounded-xl text-left grid gap-4 transition duration-200 ease-in hover:bg-background-primary">
						<h3>
							<span class="w-3 h-3 rounded-full bg-primary inline-block"></span>{" "}
							# Dla kogo
						</h3>
						<p class="opacity-80 text-sm">
							Nie musisz umieć
							programować blockchain,
							żeby dołączyć —
							wystarczą podstawy
							programowania i{" "}
							<span class="text-primary">
								chcęć nauki
							</span>
							. Resztą zajmuje się
							zespół: nad każdym
							projektem czuwa
							wykładowca-opiekun oraz
							bardziej zaawansowani
							studenci, którzy dzielą
							się wiedzą z tymi,
							którzy dopiero
							zaczynają.
						</p>
					</div>
					<div class="bg-background-muted p-6 rounded-xl text-left grid gap-4 transition duration-200 ease-in hover:bg-background-primary">
						<h3>
							<span class="w-3 h-3 rounded-full bg-primary inline-block"></span>{" "}
							# Nasz cel
						</h3>
						<p class="opacity-80 text-sm">
							Chcemy, żeby każdy
							członek koła wychodził z
							niego nie tylko ze
							zrozumieniem, jak działa
							blockchain, ale z
							<span class="text-primary">
								{
									" realnym doświadczeniem "
								}
							</span>
							zespołowym i projektami,
							które może pokazać na
							rozmowie o pracę czy
							stażu.
						</p>
					</div>
				</div>
			</div>
		</section>
		<div class="underline mb-16" />
	</main>
	<footer id="contacts" class="max-w-4xl m-auto">
		<div class="grid sm:grid-cols-3 gap-8 sm:gap-32 justify-between mb-6">
			<div>
				<h3>
					<span class="text-accent">$</span>{" "}
					whoami
				</h3>
				<p class="opacity-80">
					Koło_naukowe_4bytes Wydział z
					informatyki
				</p>
			</div>
			<nav class="grid gap-2 text-left">
				<p class="opacity-80">// Nawigacja</p>
				<ul class="grid gap-2 sm:gap-4">
					<li class="transition hover:opacity-85 hover:-translate-y-0.5">
						<a href="#projects">Projekty</a>
					</li>
					<li class="transition hover:opacity-85 hover:-translate-y-0.5">
						<a href="#features">Cechy</a>
					</li>
					<li class="transition hover:opacity-85 hover:-translate-y-0.5">
						<a href="#about-us">O nas</a>
					</li>
					<li class="transition hover:opacity-85 hover:-translate-y-0.5">
						<a href="#contacts">Kontakty</a>
					</li>
				</ul>
			</nav>
			<nav class="grid gap-2 text-left">
				<p class="opacity-80">// Kontakt</p>
				<ul class="grid gap-2 sm:gap-4">
					<li class="transition hover:opacity-85 hover:-translate-y-0.5">
						<a
							href="https://github.com/4bytespl"
							target="_blank"
							rel="noopener"
						>
							Github
						</a>
					</li>
					<li class="transition hover:opacity-85 hover:-translate-y-0.5">
						<a
							href="https://discord.gg/WmwgXEcza"
							target="_blank"
							rel="noopener"
						>
							Discord
						</a>
					</li>
					<li class="transition hover:opacity-85 hover:-translate-y-0.5">
						<a href="mailto:4bytes@gmail.com">
							4bytes@gmail.com
						</a>
					</li>
				</ul>
			</nav>
		</div>
		<div class="underline mb-6" />
		<p>
			// EOF · 2026 <span class="text-primary">4bytes</span> ·
			built with Astro
		</p>
	</footer>
</BaseLayout>
